# 前端環境變數（Vite 只會把 VITE_ 開頭的變數放進前端程式）
# 開發：.env.development 已經有預設值；要改就新增 .env.development.local
# 正式環境：建置（pnpm build）時用環境變數提供，例如 VITE_API_BASE_URL=https://api.example.com pnpm build
#   沒有設定 VITE_API_BASE_URL 時，正式環境的前端會直接報錯，避免悄悄連到 localhost

# 後端網址（不含 /api/v1）
VITE_API_BASE_URL=http://localhost:8000
# true = 不接後端，用瀏覽器裡的假資料（Demo 用），並顯示 Debug 面板
VITE_USE_MOCK=false
