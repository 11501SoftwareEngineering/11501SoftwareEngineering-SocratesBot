# App Settings
APP_ENV=development
APP_NAME=Squicrates
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173"]
# Opt-in: after migrations on `make dev`, load core seed packs (default off).
# Does not write config.yaml — use `make -C backend seed` for Super Admin assist.
SEED_DEV_DATA=false
# Optional: comma-separated packs for `make seed` / SEED_DEV_DATA (empty = auth,course_graph).
# Known: auth, course_graph (course_graph requires auth). Example: SEED_PACKS=auth
# SEED_PACKS=

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST = "localhost"
POSTGRES_PORT = 5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
# 至少 32 字元，可用 `openssl rand -hex 32` 產生
JWT_SECRET_KEY=change_me_to_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Concurrent refresh reuse grace before theft revoke-all (default 3)
# REFRESH_REUSE_GRACE_SECONDS=3

# LLM API
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
