# App Settings
APP_ENV=development
APP_NAME=Squicrates
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
# 至少 32 字元，可用 `openssl rand -hex 32` 產生
JWT_SECRET_KEY=change_me_to_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM API
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
