# App Settings
APP_ENV=development
APP_NAME=Squicrates
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173"]
# Opt-in: after migrations on `make dev`, load core seed packs (default off).
# Does not write config.yaml — use `make -C backend seed` for Super Admin assist.
SEED_DEV_DATA=false
# Optional: comma-separated packs for `make seed` / SEED_DEV_DATA (empty = auth,course_graph).
# Known: auth, course_graph (course_graph requires auth). Example: SEED_PACKS=auth
SEED_PACKS=

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST = "localhost"
POSTGRES_PORT = 5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
# 至少 32 字元，可用 `openssl rand -hex 32` 產生
JWT_SECRET_KEY=change_me_to_a_secure_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Concurrent refresh reuse grace before theft revoke-all (default 3)
REFRESH_REUSE_GRACE_SECONDS=3

# Login brute-force limit (per account and per IP; defaults 5 / 900s)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# 用來加密老師自己的 OpenRouter key。至少 32 字元，可用 `openssl rand -hex 32` 產生。
# 換掉這把金鑰後，已存的老師 key 無法解密。
TEACHER_API_KEY_SECRET=change_me_teacher_api_key_secret_32

# LLM API via OpenRouter. The model id stays on the server; clients do not send it.
# 伺服器 OpenRouter key，以逗號分隔，可只放一把。伺服器付費的呼叫會在這些 key 之間輪流使用；
# 某把 key 回 429/402 時，該模型會先停用那把 key，再換下一把重試。
# 課程老師有設自己的 key 時，該課程的呼叫改用老師的 key，不參與輪替。
# 例：OPENAI_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb
OPENAI_API_KEYS=
# 回應沒有 Retry-After 時，key 停用的秒數（預設 60）。
OPENAI_KEY_COOLDOWN_SECONDS=60
# Fast model for the Stage 2 validity gate, which runs on every student turn.
OPENAI_VALIDITY_MODEL=openai/gpt-6-luna
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Dialogue context budget includes prompt, schema, framing, safety margin, and
# reserved output tokens. A model without a reviewed tokenizer mapping is rejected.
DIALOGUE_CONTEXT_TOKEN_BUDGET=12000
