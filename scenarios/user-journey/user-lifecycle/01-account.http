###

# @name changePassword
# @ref getMeAfterLanguage
PUT {{BASE_URL}}/auth/password
Authorization: {{accountToken}}
Content-Type: application/json

{
    "old_password": "{{password}}",
    "new_password": "{{newPassword}}"
}

{{
    test.status(200);

    const { equal } = require('assert');

    test('Password change confirms the update', () => {
        equal(JSON.parse(response.body).message, 'Password updated');
    });
}}

###

# @name loginWithNewPassword
# @ref changePassword
POST {{BASE_URL}}/auth/login
Content-Type: application/json

{
    "account_id": "{{account}}",
    "password": "{{newPassword}}"
}

{{
    test.status(200);

    const { equal, ok } = require('assert');

    test('The new password logs in and keeps the chosen language', () => {
        const data = JSON.parse(response.body);
        equal(data.account_id, account);
        equal(data.preferred_language, 'en');
    });

    // httpyac joins the two Set-Cookie headers into one comma-separated string.
    const cookies = String(response.headers['set-cookie']);
    const refresh = /refresh_token=([^;,]+)/.exec(cookies);
    const csrf = /csrf_token=([^;,]+)/.exec(cookies);

    test('Login sets a refresh cookie and a CSRF cookie', () => {
        ok(refresh, 'refresh_token cookie');
        ok(csrf, 'csrf_token cookie');
    });

    exports.refreshToken = refresh[1];
    exports.csrfToken = csrf[1];
}}

###

# Control for the logout check below: before logout the refresh cookie renews a
# GET without a Bearer. Renewal rotates both cookies, so keep the new pair.
# @name renewBeforeLogout
# @ref loginWithNewPassword
# @no-cookie-jar
GET {{BASE_URL}}/users/me
Cookie: refresh_token={{refreshToken}}; csrf_token={{csrfToken}}

{{
    test.status(200);

    const { equal, ok } = require('assert');

    test('Before logout the refresh cookie renews a request without a Bearer', () => {
        equal(JSON.parse(response.body).account_id, account);
    });

    const cookies = String(response.headers['set-cookie']);
    const refresh = /refresh_token=([^;,]+)/.exec(cookies);
    const csrf = /csrf_token=([^;,]+)/.exec(cookies);

    test('Renewal rotates the refresh and CSRF cookies', () => {
        ok(refresh, 'refresh_token cookie');
        ok(csrf, 'csrf_token cookie');
    });

    exports.refreshToken = refresh[1];
    exports.csrfToken = csrf[1];
}}

###

# @name logout
# @ref renewBeforeLogout
# @no-cookie-jar
POST {{BASE_URL}}/auth/logout
Cookie: refresh_token={{refreshToken}}; csrf_token={{csrfToken}}
X-CSRF-Token: {{csrfToken}}

{{
    test.status(200);

    const { equal } = require('assert');

    test('Logout reports ok', () => {
        equal(JSON.parse(response.body).ok, true);
    });
}}

###

# @name verifyLogoutRevokedSession
# @ref logout
# @no-cookie-jar
GET {{BASE_URL}}/users/me
Cookie: refresh_token={{refreshToken}}; csrf_token={{csrfToken}}

# The same cookie renewed the request before logout. After logout the refresh
# session is revoked, so it no longer does.
?? status == 401
