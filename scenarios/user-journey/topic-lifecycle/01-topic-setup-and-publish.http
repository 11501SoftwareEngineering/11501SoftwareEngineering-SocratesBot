# ============================================
# @name deleteCourse
# @ref taTopics
DELETE {{BASE_URL}}/courses/{{courseId}}
Authorization: {{teacherToken}}

?? status == 204

###

# @name teacherCourseListAfterDelete
# @ref deleteCourse
GET {{BASE_URL}}/courses
Authorization: {{teacherToken}}

{{
    test.status(200);

    const { ok } = require('assert');

    test('The deleted course is gone from the teacher\'s list', () => {
        ok(!JSON.parse(response.body).some((c) => c.course_id === courseId));
    });
}}
