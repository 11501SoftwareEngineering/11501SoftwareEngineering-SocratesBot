# Copy this file to .env. Run scenarios only against a local or development backend.
#
# This journey calls the model. The backend needs a usable LLM setup: the
# server's OPENAI_API_KEY, or the key of the teacher or TA making the call.

# Base URL of the API, including the /api/v1 prefix.
BASE_URL=http://127.0.0.1:8000/api/v1

# Seed teacher (see docs/測試資料.md). The seed must have run first:
#   make -C backend seed
TEACHER_ACCOUNT_ID=dev-teacher
TEACHER_PASSWORD=password1
