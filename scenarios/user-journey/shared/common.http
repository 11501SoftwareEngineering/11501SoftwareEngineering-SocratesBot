# ============================================
# The TA candidate
# ============================================
# @name registerTa
{{
    exports.taAccount = `scn-ta-${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`;
}}
POST {{BASE_URL}}/auth/register
Content-Type: application/json

{
    "account_id": "{{taAccount}}",
    "password": "{{password}}",
    "name": "Scenario TA"
}

{{
    test.status(200);

    const { equal } = require('assert');

    test('The TA candidate registers as a USER', () => {
        const data = JSON.parse(response.body);
        equal(data.role, 'USER');
        equal(data.account_id, taAccount);
    });
}}

