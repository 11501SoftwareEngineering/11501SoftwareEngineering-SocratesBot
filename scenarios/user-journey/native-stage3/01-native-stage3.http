###
# @name studentPublished
# @no-cookie-jar
GET {{BASE_URL}}/topics/{{TOPIC_ID}}/summary/published
Authorization: Bearer {{STUDENT_TOKEN}}

{{
    test.status(200);
    const { ok, equal } = require('assert');
    const data = JSON.parse(response.body).summary;
    ok(data);
    equal(Object.hasOwn(data, 'native_synthesis'), false);
    equal(Object.hasOwn(data, 'sources'), false);
    data.groups.forEach(group => equal(Object.hasOwn(group, 'report_ids'), false));
}}

